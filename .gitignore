# Runtime outputs
output/
delivery/
*.mat
*.fig
*.asv
*.m~

# MATLAB solver working dirs
matlab/**/CurrentComp/
matlab/**/*.fig

# LaTeX build artifacts
latex-report/*.aux
latex-report/*.log
latex-report/*.out
latex-report/*.toc
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc

# COMSOL exports (regenerable)
comsol/export/
tools/comsol/*.class

# Local screen recordings can include private desktop content
reports/**/gui-recordings/

# Python
__pycache__/
*.pyc
.venv/

# Node dependencies from local deck/runtime checks
node_modules/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Optional local overrides
config_paths_local.m
*.xlsx
~$*
